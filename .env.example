# MongoDB Connection String (Atlas Replica Set or local replica set)
MONGODB_URI=mongodb://username:password@cluster0.mongodb.net:27017/?ssl=true&replicaSet=atlas-rs&authSource=admin

# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-32-byte-base64-secret-key

# Google Maps API (Optional: app automatically falls back to Haversine geospatial radar if unset)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-api-key
